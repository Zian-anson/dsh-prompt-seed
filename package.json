{
  "name": "dsh-prompt-seed",
  "version": "0.20.0",
  "description": "DSH composer: proactive one-call draft rewriting and independent next-reply prediction, with session-scoped jobs and safe draft recovery.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "prompt",
    "prompt-engineering",
    "prompt-optimization",
    "composer",
    "llm"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check:docs": "node tools/check-doc-counts.mjs",
    "check:install": "node tools/check-local-install.mjs",
    "stats": "node tools/sample-stats.mjs",
    "check:wire": "node tools/check-route-wire.mjs",
    "bench": "node tools/bench.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "test": "node tools/build.mjs && node tools/check-doc-counts.mjs && node tools/check-local-install.mjs && node tools/check-route-wire.mjs && node --test test/*.test.mjs",
    "prepack": "node tools/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zian-anson/dsh-prompt-seed.git"
  },
  "homepage": "https://github.com/Zian-anson/dsh-prompt-seed#readme",
  "bugs": {
    "url": "https://github.com/Zian-anson/dsh-prompt-seed/issues"
  }
}
